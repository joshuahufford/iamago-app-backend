# Copy to .env and adjust. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Postgres. Matches the docker-compose service defaults.
DATABASE_URL=postgres://iamago:iamago@localhost:5432/iamago

# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Google Maps. Leave blank in development: geocoding falls back to a small
# bundled city table and the frontend renders a list-only view.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
